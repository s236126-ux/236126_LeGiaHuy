
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${BACKEND_URL};

        proxy_ssl_server_name on;
        proxy_ssl_name api-236126.onrender.com;

        proxy_set_header Host api-236126.onrender.com;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
